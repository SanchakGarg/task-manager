# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Get these from your Neon project dashboard → Connection string
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/taskmanager?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/taskmanager?sslmode=require"

# ── NextAuth / Auth.js ────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
NEXTAUTH_SECRET="replace-with-random-secret"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Drive API, Google Docs API, Google Sheets API
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxx"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:you@example.com"

# ── Vercel Cron protection ────────────────────────────────────────────────────
# Set any random string; add as Authorization: Bearer <value> in Vercel cron config
CRON_SECRET="replace-with-random-secret"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── GitHub Releases (for /download page) ─────────────────────────────────────
GITHUB_REPO="SanchakGarg/task-manager"
# Optional: add a GitHub PAT for higher API rate limits
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
