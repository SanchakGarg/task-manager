{
  "name": "taskmanager",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "cd packages/db && bunx prisma generate",
    "db:push": "cd packages/db && bunx prisma db push",
    "db:migrate": "cd packages/db && bunx prisma migrate dev",
    "db:studio": "cd packages/db && bunx prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
